# PostgreSQL connection (RDS endpoint in production)
DATABASE_URL=postgresql+psycopg://caprae:caprae@localhost:5432/caprae
# Comma-separated browser origins allowed to call the API (your Next.js URL)
CORS_ORIGINS=http://localhost:3000
# Optional: enables Claude-powered AI Outreach Copilot (falls back to templates when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Seed 30 fictional demo leads on first start
SEED_SAMPLE_DATA=true
# Crawler tuning
CRAWLER_CONCURRENCY=5
CRAWLER_TIMEOUT_SECONDS=8
ENRICHMENT_CACHE_DAYS=7
RESPECT_ROBOTS_TXT=true
# CRAWLER_PROXY_URL=http://user:pass@proxy:8080
